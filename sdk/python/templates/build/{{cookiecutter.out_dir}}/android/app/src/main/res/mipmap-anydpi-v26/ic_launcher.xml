<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the adaptive icon for Android 8 and later. Without this file the
     launcher falls back to the legacy square mipmap and wraps it in its own
     white circle, shrinking the artwork to roughly 70% on the way in - so a
     correctly sized icon still shows up small. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
