# Auth0 Native application (public client) — no client secret.
# Register redirect URI on the Auth0 app: flet://oauth-callback
#
# Package this file with: include = [".env"] under [tool.flet.app]
# (see publish docs). Copy to .env and fill in values before building.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-native-app-client-id
# AUTH0_AUDIENCE=https://your-api.example.com
# AUTH0_REDIRECT_URL=flet://oauth-callback
