# Auth0 Native application (public client) — no client secret.
# Register redirect URI on the Auth0 app to match your AppAuth scheme.
# With tool.flet.project = "appauth", flet build defaults the scheme to "appauth":
#   appauth://oauth-callback
#
# .env is excluded from the package by default. Keep it with either:
#   [tool.flet.app] include = [".env"]
#   flet build apk --include .env
# Copy this file to .env and fill in values before building.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-native-app-client-id
# AUTH0_AUDIENCE=https://your-api.example.com
# AUTH0_REDIRECT_URL=appauth://oauth-callback
