# Public native OIDC client (Pocket ID, Auth0 public app, etc.) — no client secret.
# Register redirect URI on the IdP: flet://oauth-callback
#
# Package this file with: include = [".env"] under [tool.flet.app]
# (see publish docs). Copy to .env and fill in values before building.

AUTH_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=your-public-client-id
# OIDC_ANDROID_REDIRECT=flet://oauth-callback
# OIDC_SCOPES=openid profile email
